---
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import about from '../data/about.json';
import certifications from '../data/certifications.json';
import { isTodo } from '../lib/projects';

type Cert = { name: string; issuer?: string; year?: string | number; url?: string };
---

<Base title="About" description="About Rami Salah: DevOps engineer, coach, chess player, trainer and creator.">
  <section class="container section">
    <h1>About</h1>
    <div class="top">
      <Text value={about.intro} as="p" class="intro" />
      {
        about.now?.length > 0 && (
          <aside class="now" aria-labelledby="now-heading">
            <h2 id="now-heading">Right now</h2>
            <ul>
              {about.now.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <h2>Beyond DevOps</h2>
    <ul class="grid sides">
      {
        about.cards.map((c) => (
          <li class="card">
            <h3 class="side-title">{c.title}</h3>
            <Text value={c.text} as="p" />
            <p class="link">
              {c.link.url && !isTodo(c.link.label) ? (
                <a href={c.link.url}>{c.link.label} →</a>
              ) : (
                <span class="todo">TODO: link</span>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <h2>Education and certifications</h2>
    {
      certifications.length === 0 ? (
        <p class="todo">TODO: add certifications to src/data/certifications.json</p>
      ) : (
        <ul class="certs">
          {(certifications as Cert[]).map((c) => (
            <li>
              <span class="cert-name">{c.url ? <a href={c.url}>{c.name}</a> : c.name}</span>
              <span class="muted">{[c.issuer, c.year].filter(Boolean).join(' · ')}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  .top {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 52rem) {
    .top {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }
  .top :global(.intro) {
    font-size: 1.125rem;
    margin: 0;
  }
  .now {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1rem;
  }
  .now h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .now ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .now li + li {
    margin-top: 0.4rem;
  }
  .side-title {
    font-size: 1.05rem;
    margin: 0;
  }
  .link {
    font-family: var(--mono);
    font-size: 0.9rem;
    margin-top: auto !important;
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .certs li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .cert-name {
    font-family: var(--mono);
  }
</style>
