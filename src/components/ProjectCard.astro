---
import type { DevopsProject } from '../lib/projects';
import { formatDate } from '../lib/projects';
import Tags from './Tags.astro';

interface Props {
  project: DevopsProject;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: H = 'h3' } = Astro.props;
const { title, summary, tools, date, diagram, live } = project.data;
---

<li class="card project-card">
  {
    diagram && (
      <div class="thumb" aria-hidden="true">
        <img src={diagram.src} width={diagram.width} height={diagram.height} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="body">
    <H class="card-title"><a href={`/projects/${project.id}/`}>{title}</a></H>
    <p>{summary}</p>
    <Tags tools={tools} />
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {live && <span class="live">● live</span>}
      <span class="more" aria-hidden="true">case study →</span>
    </p>
  </div>
</li>

<style>
  .project-card {
    position: relative;
    padding: 0;
    overflow: hidden;
  }
  .thumb {
    height: 170px;
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-title {
    font-size: 1.05rem;
  }
  .card-title a {
    color: var(--text);
    text-decoration: none;
  }
  /* Whole card is clickable, but the link text stays the accessible name. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-card:hover {
    border-color: var(--accent);
  }
  .project-card:hover .more {
    color: var(--accent);
  }
  .project-card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .card-title a:focus-visible {
    outline: none;
  }
  .meta {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: auto !important;
    padding-top: 0.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .live {
    color: var(--accent);
  }
  .more {
    margin-left: auto;
  }
</style>
